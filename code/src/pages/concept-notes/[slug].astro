---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { isSiteVisible, normalizeArticle } from "../../lib/content";
import { getRelatedArticles } from "../../lib/related";
import { resolveSlug } from "../../lib/slugs";
import { getTopicObjectsForArticle } from "../../lib/topics";

export async function getStaticPaths() {
  const entries = await getCollection("briefs");
  return entries
    .filter((e) => isSiteVisible(e.data.status))
    .map((entry) => ({
      params: { slug: resolveSlug(entry.id, entry.data.slug) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const article = normalizeArticle(entry);
const relatedArticles = await getRelatedArticles(article);
const topicObjects = await getTopicObjectsForArticle(article);
---
<ArticleLayout
  article={article}
  relatedArticles={relatedArticles}
  topicObjects={topicObjects}
  Content={Content}
/>
