---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/editorial/ArchiveList.astro";
import { getBriefs } from "../../lib/content";

const articles = (await getBriefs()).sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
---
<BaseLayout title="Briefs" description="Timely explainers on frontier AI.">
  <section class="archive-header">
    <p class="eyebrow">Briefs</p>
    <h1 class="article-title">Briefs</h1>
  </section>
  {
    articles.length === 0 ? (
      <p>No published briefs yet.</p>
    ) : (
      <ArchiveList articles={articles} />
    )
  }
</BaseLayout>
