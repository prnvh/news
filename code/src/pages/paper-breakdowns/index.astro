---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/editorial/ArchiveList.astro";
import { getResearchNotes } from "../../lib/content";

const articles = (await getResearchNotes()).sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
---
<BaseLayout title="Paper Breakdowns" description="Atomic paper notes that update larger field maps.">
  <section class="archive-header">
    <p class="eyebrow">Paper breakdowns</p>
    <h1 class="article-title">Paper Breakdowns</h1>
    <p class="article-subtitle">Problem, core idea, method, result, assumptions, connections, confusions, buildable ideas, and how the paper changes the map.</p>
  </section>
  {
    articles.length === 0 ? (
      <p>No published paper breakdowns yet.</p>
    ) : (
      <ArchiveList articles={articles} />
    )
  }
</BaseLayout>
