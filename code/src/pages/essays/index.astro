---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/editorial/ArchiveList.astro";
import { getEssays } from "../../lib/content";

const articles = (await getEssays()).sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
---
<BaseLayout title="Essays" description="Long-form arguments on frontier AI and research culture.">
  <section class="archive-header">
    <p class="eyebrow">Essays</p>
    <h1 class="article-title">Essays</h1>
  </section>
  {
    articles.length === 0 ? (
      <p>No published essays yet.</p>
    ) : (
      <ArchiveList articles={articles} />
    )
  }
</BaseLayout>
