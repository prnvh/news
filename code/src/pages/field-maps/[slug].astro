---
import { getCollection, render } from "astro:content";
import FieldMapLayout from "../../layouts/FieldMapLayout.astro";
import {
  getAllArticles,
  getBriefs,
  getResearchNotes,
  isSiteVisible,
  normalizeArticle,
} from "../../lib/content";
import { resolveSlug } from "../../lib/slugs";

export async function getStaticPaths() {
  const entries = await getCollection("fieldMaps");
  return entries
    .filter((e) => isSiteVisible(e.data.status))
    .map((entry) => ({
      params: { slug: resolveSlug(entry.id, entry.data.slug) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const article = normalizeArticle(entry);
const articleTopics = new Set(article.topics.map((topic) => topic.toLowerCase()));
const BROAD_TOPICS = new Set([
  "ai",
  "technical-world",
  "hardware",
  "compute",
  "systems",
]);
const sharesTopic = (candidate: typeof article) => {
  const shared = candidate.topics
    .map((topic) => topic.toLowerCase())
    .filter((topic) => articleTopics.has(topic));
  const specific = shared.filter((topic) => !BROAD_TOPICS.has(topic));
  return specific.length > 0;
};
const sortNewest = (a: typeof article, b: typeof article) =>
  b.date.getTime() - a.date.getTime();

const allNotes = (await getAllArticles())
  .filter(
    (item) =>
      isSiteVisible(item.status) &&
      (item.type === "brief" || item.type === "research-note"),
  )
  .sort(sortNewest);

const recentPapers = (await getResearchNotes())
  .filter(sharesTopic)
  .sort(sortNewest);
const relatedConceptNotes = (await getBriefs())
  .filter(sharesTopic)
  .sort(sortNewest);
---
<FieldMapLayout
  article={article}
  recentPapers={recentPapers}
  relatedConceptNotes={relatedConceptNotes}
  allNotes={allNotes}
  Content={hasBody ? Content : undefined}
/>
