---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/editorial/ArchiveList.astro";
import { getFieldMaps } from "../../lib/content";

const articles = (await getFieldMaps()).sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
---
<BaseLayout title="Field Maps" description="Evergreen guides to major research areas.">
  <section class="archive-header">
    <p class="eyebrow">Field Maps</p>
    <h1 class="article-title">Field Maps</h1>
    <p class="article-subtitle">Durable maps of important research areas.</p>
  </section>
  {
    articles.length === 0 ? (
      <p>No published field maps yet.</p>
    ) : (
      <ArchiveList articles={articles} />
    )
  }
</BaseLayout>
