---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveList from "../../components/editorial/ArchiveList.astro";
import { getResearchNotes } from "../../lib/content";

const articles = (await getResearchNotes()).sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
---
<BaseLayout title="Research Notes" description="Notes on papers, benchmarks, and technical reports.">
  <section class="archive-header">
    <p class="eyebrow">Research Notes</p>
    <h1 class="article-title">Research Notes</h1>
    <p class="article-subtitle">Paper breakdowns, benchmark notes, and technical observations.</p>
  </section>
  {
    articles.length === 0 ? (
      <p>No published research notes yet.</p>
    ) : (
      <ArchiveList articles={articles} />
    )
  }
</BaseLayout>
