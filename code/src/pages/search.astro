---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Search" description="Search Frontier Manual.">
  <section class="archive-header">
    <p class="eyebrow">Search</p>
    <h1 class="article-title">Search</h1>
    <p class="article-subtitle">Find field maps, paper breakdowns, concept notes, and field breakdowns.</p>
  </section>
  <div class="search-ui">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
  </div>
</BaseLayout>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  if (import.meta.env.DEV) {
    const el = document.getElementById("search");
    if (el) {
      el.innerHTML =
        "<p>Run <code>npm run build && npm run preview</code> to use search locally.</p>";
    }
  } else {
    new PagefindUI({
      element: "#search",
      showImages: false,
    });
  }
</script>
