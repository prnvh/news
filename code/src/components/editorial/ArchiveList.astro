---
import type { NormalizedArticle } from "../../lib/types";
import { formatRelativeDate } from "../../lib/format-date";

interface Props {
  articles: NormalizedArticle[];
}

const { articles } = Astro.props;
---

<div class="archive-list">
  {articles.map((article) => (
    <article class="archive-entry">
      <a class="archive-entry-link" href={article.url}>
        <span class="archive-entry-copy">
          <span class="story-title">{article.title}</span>
          <span class="entry-meta">{formatRelativeDate(article.date, "")}</span>
        </span>
        <span class="archive-entry-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </article>
  ))}
</div>
