---
import type { NormalizedArticle } from "../../lib/types";
interface Props {
  articles: NormalizedArticle[];
}
const { articles } = Astro.props;
---

<div class="archive-list archive-list--rows">
  {articles.map((article) => (
    <article class="archive-entry" data-type={article.type}>
      <a class="archive-row" href={article.url}>
        <h2>{article.title}</h2>
        <time class="entry-meta" datetime={article.date.toISOString()}>
          {article.date.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "short",
            year: "numeric",
            timeZone: "UTC",
          })}
        </time>
      </a>
    </article>
  ))}
</div>
