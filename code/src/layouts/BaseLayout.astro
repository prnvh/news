---
import "../styles/global.css";
import { publication } from "../config/publication";
import Analytics from "@vercel/analytics/astro";
import EntryTabs from "../components/editorial/EntryTabs.astro";
import type { ArticleType } from "../lib/types";
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  chrome?: "site" | "article" | "field-map";
  sectionTitle?: string;
  entryType?: ArticleType;
}
const {
  title,
  description = publication.tagline,
  image,
  canonical,
  chrome = "site",
  entryType,
} = Astro.props;
const pageTitle =
  title === publication.name ? title : `${title} — ${publication.name}`;
const ogImage = new URL(image ?? publication.defaultOgImage, publication.url)
  .href;
const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, publication.url).href;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isEntryIndex = [
  "/",
  "/all",
  "/field-maps",
  "/paper-notes",
  "/concept-notes",
  "/field-breakdowns",
].includes(path);
const browse = [
  { label: "home", href: "/" },
  { label: "topics", href: "/topics" },
  { label: "about", href: "/about" },
  { label: "subscribe", href: "/subscribe" },
];
const current = (href: string) =>
  path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      property="og:type"
      content={chrome === "article" ? "article" : "website"}
    />
    <meta property="og:site_name" content={publication.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${publication.name} RSS`}
      href="/rss.xml"
    />
    <Analytics />
  </head>
  <body class="sidebar-page">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="mobile-header">
      {!isEntryIndex && <a href="/">Frontier Manual</a>}
      <details class="mobile-menu">
        <summary>menu</summary>
        <nav aria-label="Mobile navigation">
          {browse.map((item) => (
            <a
              href={item.href}
              aria-current={current(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </header>
    <aside class="home-sidebar" aria-label="Site navigation">
      <nav aria-labelledby="browse-label">
        <p class="sidebar-label" id="browse-label">
          browse
        </p>
        {browse.map((item) => (
          <a
            href={item.href}
            aria-current={current(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </aside>
    <main
      id="main"
      class:list={[
        "plain-page",
        chrome === "article" && "article-page",
        chrome === "field-map" && "field-map-page",
      ]}
    >
      {!isEntryIndex && (
        <a class="publication-link" href="/">
          Frontier Manual
        </a>
      )}
      {entryType && <EntryTabs activeType={entryType} />}
      <slot />
      <footer class="page-footer">
        <a href="https://pranavh.vercel.app">Pranav Harikumar</a>
        <a href="/rss.xml">RSS</a>
      </footer>
    </main>
  </body>
</html>
