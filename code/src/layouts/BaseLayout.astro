---
import "../styles/global.css";
import { publication } from "../config/publication";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  chrome?: "journal" | "field-map";
  sectionTitle?: string;
}

const {
  title,
  description = publication.tagline,
  image,
  canonical,
  chrome = "journal",
  sectionTitle,
} =
  Astro.props;
const pageTitle =
  title === publication.name ? title : `${title} - ${publication.name}`;
const ogImage = image
  ? new URL(image, publication.url).href
  : new URL(publication.defaultOgImage, publication.url).href;
const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, publication.url).href;
const path = Astro.url.pathname;
const primaryNav = [
  { label: "Field Maps", href: "/field-maps" },
  { label: "Paper Breakdowns", href: "/paper-breakdowns" },
  { label: "Concept Notes", href: "/concept-notes" },
  { label: "Field Breakdowns", href: "/field-breakdowns" },
];
const footerNav = [
  ...primaryNav,
  { label: "Topics", href: "/topics" },
  { label: "Start Here", href: "/start-here" },
  { label: "About", href: "/about" },
  { label: "Subscribe", href: "/subscribe" },
  { label: "RSS", href: "/rss.xml" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={publication.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${publication.name} RSS`}
      href="/rss.xml"
    />
    <Analytics />
  </head>
  <body>
    <div class:list={["site-frame", chrome === "field-map" && "site-frame--field-map"]}>
      <header class:list={["site-header", chrome === "field-map" && "site-header--field-map"]}>
        {
          chrome === "field-map" ? (
            <nav class="field-map-topbar" aria-label="Field map navigation">
              <a class="field-map-back-link" href="/">
                <span aria-hidden="true">&larr;</span>
                <span>{publication.name}</span>
              </a>
              <a class="field-map-current-link" href="/field-maps">
                <span>{sectionTitle ?? title}</span>
                <span aria-hidden="true">&#8964;</span>
              </a>
              <a class="field-map-search-link" href="/search" aria-label="Search">
                <span>Search</span>
                <span class="field-map-search-icon" aria-hidden="true"></span>
              </a>
            </nav>
          ) : (
            <>
              <div class="masthead-bar">
                <a class="menu-link" href="/all" aria-label="All entries">
                  <span></span>
                  <span></span>
                  <span></span>
                </a>
                <a class="site-wordmark" href="/" aria-label={`${publication.name} home`}>
                  {publication.name}
                </a>
                <a class="search-link" href="/search" aria-label="Search">
                  <span></span>
                </a>
              </div>
              <nav class="site-nav" aria-label="Primary navigation">
                {primaryNav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={path === item.href || path.startsWith(`${item.href}/`)
                      ? "page"
                      : undefined}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            </>
          )
        }
      </header>

      <main class:list={["site-main", chrome === "field-map" && "site-main--field-map"]}>
        <slot />
      </main>

      <footer class="site-footer">
        <p>{publication.name}</p>
        <nav aria-label="Footer navigation">
          {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <p>&copy; {new Date().getFullYear()}</p>
      </footer>
    </div>
  </body>
</html>
