---
import BaseLayout from "./BaseLayout.astro";
import DraftBanner from "../components/editorial/DraftBanner.astro";
import { articleSeo } from "../lib/content";
import type { NormalizedArticle } from "../lib/types";
interface Props {
  article: NormalizedArticle;
  recentPapers: NormalizedArticle[];
  relatedConceptNotes: NormalizedArticle[];
  allNotes?: NormalizedArticle[];
  Content?: import("astro").MarkdownInstance<unknown>["Content"];
}
const {
  article,
  recentPapers,
  relatedConceptNotes,
  allNotes = [...relatedConceptNotes, ...recentPapers],
  Content,
} = Astro.props;
const seo = articleSeo(article);
const sections = "mapSections" in article.data ? article.data.mapSections : [];
const orientation =
  "orientation" in article.data ? article.data.orientation : article.subtitle;
const bySlug = new Map(allNotes.map((note) => [note.slug, note]));
const branches = sections.map((section) => {
  const anchor =
    section.anchor ||
    section.title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  const words = section.title
    .toLowerCase()
    .split(/[^a-z0-9]+/)
    .filter((word) => word.length > 3);
  const notes = Array.isArray(section.slugs)
    ? section.slugs
        .map((slug) => bySlug.get(slug))
        .filter((note): note is NormalizedArticle => Boolean(note))
    : allNotes.filter((note) =>
        words.some((word) =>
          [note.title, note.description, ...note.topics]
            .join(" ")
            .toLowerCase()
            .includes(word),
        ),
      );
  return { ...section, anchor, notes };
});
const populatedBranches = branches.filter(
  (branch) => branch.notes.length > 0 || branch.href,
);
const emptyBranches = branches.filter(
  (branch) => branch.notes.length === 0 && !branch.href,
);
const hasMapNotes =
  "body" in article.entry && Boolean(article.entry.body?.trim());
const updated = article.updated ?? article.date;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  canonical={seo.canonical}
  chrome="field-map"
  entryType="field-map"
>
  <DraftBanner status={article.status} />
  <article>
    <header class="field-map-hero">
      <div class="field-map-heading">
        <h1>{article.title}</h1>
        <p class="field-map-updated">
          Updated{" "}
          {updated.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "short",
            year: "numeric",
            timeZone: "UTC",
          })}
        </p>
      </div>
      <p class="field-map-scope">{orientation}</p>
    </header>
    <div class="field-map-branches">
      {populatedBranches.map((branch) => (
        <section class="field-map-branch" aria-labelledby={branch.anchor}>
          <header class="field-map-branch-header">
            <h2 id={branch.anchor}>
              {branch.href ? (
                <a href={branch.href}>{branch.title}</a>
              ) : (
                branch.title
              )}
            </h2>
            <p>{branch.description}</p>
          </header>
          {branch.notes.length > 0 && (
            <ul class="field-map-note-list">
              {branch.notes.map((note) => (
                <li>
                  <a href={note.url}>{note.title}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
      {emptyBranches.map((branch) => (
        <details class="field-map-empty">
          <summary id={branch.anchor}>
            {branch.title} <span>No notes yet</span>
          </summary>
          <p>{branch.description}</p>
        </details>
      ))}
    </div>
    {Content && hasMapNotes && (
      <div class="article-body field-map-prose">
        <Content />
      </div>
    )}
  </article>
</BaseLayout>
