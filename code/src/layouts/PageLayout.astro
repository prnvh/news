---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { publication } from "../config/publication";

interface Props {
  page: CollectionEntry<"pages">;
  Content: import("astro").MarkdownInstance<unknown>["Content"];
}
const { page, Content } = Astro.props;
const description = page.data.description ?? page.data.subtitle ?? publication.tagline;
const title = page.data.seo?.title ?? page.data.title;
---
<BaseLayout
  title={title}
  description={page.data.seo?.description ?? description}
  image={page.data.seo?.image}
>
  <article class="article-body" data-pagefind-body>
    <header class="article-header">
      <h1 class="article-title">{page.data.title}</h1>
      {page.data.subtitle && <p class="article-subtitle">{page.data.subtitle}</p>}
    </header>
    <Content />
    <slot />
  </article>
</BaseLayout>
