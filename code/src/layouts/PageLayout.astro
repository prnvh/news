---
import BaseLayout from "./BaseLayout.astro";
import DraftBanner from "../components/editorial/DraftBanner.astro";
import type { CollectionEntry } from "astro:content";
import { publication } from "../config/publication";

interface Props {
  page: CollectionEntry<"pages">;
  Content: import("astro").MarkdownInstance<unknown>["Content"];
}

const { page, Content } = Astro.props;
const description = page.data.description ?? page.data.subtitle ?? publication.tagline;
const title = page.data.seo?.title ?? page.data.title;
const isDraft = page.data.status === "draft";
---
<BaseLayout
  title={title}
  description={page.data.seo?.description ?? description}
  image={page.data.seo?.image}
>
  <DraftBanner status={page.data.status} />
  <article
    class="journal-article journal-page"
    data-pagefind-body={isDraft ? undefined : true}
    data-pagefind-ignore={isDraft ? true : undefined}
  >
    <header class="journal-article-header">
      <h1 class="journal-article-title">{page.data.title}</h1>
      {page.data.subtitle && <p class="journal-article-date">{page.data.subtitle}</p>}
    </header>
    <div class="journal-article-body article-body">
      <Content />
    </div>
    <slot />
  </article>
</BaseLayout>
