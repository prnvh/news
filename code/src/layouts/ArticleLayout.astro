---
import BaseLayout from "./BaseLayout.astro";
import ArticleMetadata from "../components/editorial/ArticleMetadata.astro";
import DraftBanner from "../components/editorial/DraftBanner.astro";
import { articleSeo } from "../lib/content";
import { formatRelativeDate } from "../lib/format-date";
import type { NormalizedArticle } from "../lib/types";
import type { CollectionEntry } from "astro:content";

interface Props {
  article: NormalizedArticle;
  relatedArticles?: NormalizedArticle[];
  topicObjects: CollectionEntry<"topics">[];
  Content: import("astro").MarkdownInstance<unknown>["Content"];
}

const { article, topicObjects, Content } = Astro.props;
const seo = articleSeo(article);
const publishedLabel = formatRelativeDate(article.date);
const typeLabels: Record<NormalizedArticle["type"], string> = {
  brief: "Concept note",
  "research-note": "Paper note",
  essay: "Field breakdown",
  "field-map": "Field map",
};
const typeLabel = typeLabels[article.type];
const isDraft = article.status === "draft";
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  canonical={seo.canonical}
  chrome="article"
>
  <DraftBanner status={article.status} />
  <article
    class="journal-article"
    data-pagefind-body={isDraft ? undefined : true}
    data-pagefind-ignore={isDraft ? true : undefined}
    data-pagefind-meta={isDraft ? undefined : `type:${article.type}`}
  >
    {
      !isDraft && (
        <>
          <span
            class="visually-hidden"
            aria-hidden="true"
            data-pagefind-meta={`topics:${article.topics.join(", ")}`}
          />
          <span
            class="visually-hidden"
            aria-hidden="true"
            data-pagefind-meta={`tags:${article.tags.join(", ")}`}
          />
        </>
      )
    }

    <header class="journal-article-header">
      <p class="journal-article-kicker">{typeLabel}</p>
      <h1 class="journal-article-title">{article.title}</h1>
      <p class="journal-article-author">{article.author}</p>
      <p class="journal-article-date">{publishedLabel}</p>
    </header>

    <div class="journal-article-body article-body">
      <Content />
    </div>

    <ArticleMetadata article={article} topicObjects={topicObjects} />
  </article>
</BaseLayout>
