---
import BaseLayout from "./BaseLayout.astro";
import ArticleMetadata from "../components/editorial/ArticleMetadata.astro";
import DraftBanner from "../components/editorial/DraftBanner.astro";
import { articleSeo } from "../lib/content";
import type { NormalizedArticle } from "../lib/types";
import type { CollectionEntry } from "astro:content";

interface Props {
  article: NormalizedArticle;
  topicObjects: CollectionEntry<"topics">[];
  Content: import("astro").MarkdownInstance<unknown>["Content"];
}

const { article, topicObjects, Content } = Astro.props;
const seo = articleSeo(article);
const publishedLabel = article.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const typeLabels: Record<NormalizedArticle["type"], string> = {
  brief: "Concept note",
  "research-note": "Paper note",
  essay: "Field breakdown",
  "field-map": "Field map",
};
const typeLabel = typeLabels[article.type];
const description =
  article.subtitle ||
  (article.description !== article.title ? article.description : undefined);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  canonical={seo.canonical}
  chrome="article"
  entryType={article.type}
>
  <DraftBanner status={article.status} />
  <article class="journal-article">
    <header class="journal-article-header">
      <p class="journal-article-date">
        {typeLabel} · {publishedLabel}
      </p>
      <h1 class="journal-article-title">{article.title}</h1>
      {description && <p class="journal-article-subtitle">{description}</p>}
    </header>

    <div class="journal-article-body article-body">
      <Content />
    </div>

    <ArticleMetadata article={article} topicObjects={topicObjects} />
  </article>
</BaseLayout>
