{
  "buildCommand": "npm run build",
  "framework": "astro",
  "redirects": [
    {
      "source": "/paper-breakdowns",
      "destination": "/paper-notes",
      "permanent": true
    },
    {
      "source": "/paper-breakdowns/:path*",
      "destination": "/paper-notes/:path*",
      "permanent": true
    }
  ]
}
