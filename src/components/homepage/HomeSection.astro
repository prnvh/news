---
import type { NormalizedArticle } from "../../lib/types";
import ArticleCard from "../editorial/ArticleCard.astro";

interface Props {
  label: string;
  articles: NormalizedArticle[];
  columns?: 2 | 3;
}
const { label, articles, columns } = Astro.props;
if (articles.length === 0) return null;
const gridClass = columns ? `article-grid article-grid--${columns}` : "article-grid";
---
<section>
  <hr class="rule" />
  <p class="section-label">{label}</p>
  <div class={gridClass}>
    {articles.map((article) => (
      <ArticleCard article={article} headingLevel="h3" />
    ))}
  </div>
</section>
