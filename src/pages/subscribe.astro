---
import { render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import NewsletterForm from "../components/newsletter/NewsletterForm.astro";
import { getPageBySlug } from "../lib/content";

const page = await getPageBySlug("subscribe");
if (!page) throw new Error("Missing src/content/pages/subscribe.mdx");
const { Content } = await render(page);
---
<PageLayout page={page} Content={Content}>
  <hr class="rule" />
  <NewsletterForm />
</PageLayout>
